# Copy to .env. Application defaults to real vLLM, never silently to demo.
AW_MODE=vllm
AW_DATA_DIR=./data
AW_LLM_BASE_URL=http://127.0.0.1:8000/v1
AW_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
AW_LLM_API_KEY=local-dev-key

# bm25 works without another model. vllm enables Qwen dense + BM25 hybrid retrieval.
AW_EMBEDDING_BACKEND=bm25
AW_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
AW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AW_EMBEDDING_API_KEY=local-dev-key

# Optional token for the single-user app. Set before exposing beyond localhost.
AW_API_TOKEN=
AW_MAX_STEPS=5
AW_MAX_TOKENS=1024
AW_CONTEXT_CHARS=12000
AW_HISTORY_TURNS=8
AW_REQUEST_TIMEOUT=120
AW_CHUNK_SIZE=700
AW_CHUNK_OVERLAP=100
AW_TOP_K=4
AW_MAX_UPLOAD_MB=10

# Docker and serve_vllm.py parameters.
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
VLLM_CHAT_GPU=0
VLLM_EMBED_GPU=0
VLLM_CHAT_MEMORY=0.65
VLLM_EMBED_MEMORY=0.20
VLLM_MAX_MODEL_LEN=16384
